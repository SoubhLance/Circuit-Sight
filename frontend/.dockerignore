# ==============================================================================
# CircuitSight — Frontend Docker Build Exclusions (Frontend Build Context)
# Build command: docker build -f frontend/Dockerfile -t circuitsight-frontend:latest ./frontend
# ==============================================================================

# --- Node Dependencies & Local Build Outputs ---
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo

# --- Package Manager Logs & Caches ---
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment Secrets & Local Overrides ---
.env
.env.*
!.env.example
*.local

# --- IDE, Editor, & OS Artifacts ---
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
